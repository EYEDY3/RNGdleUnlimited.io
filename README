            { id: 'harshad', name: 'Harshad Number', family: 'MATH_PROPERTIES', ep: 850, icon: 'fa-divide', desc: 'Divisible by the sum of its digits', match: n => isHarshad(n) },
            { id: 'spy_number', name: 'Spy Number', family: 'MATH_PROPERTIES', ep: 4200, icon: 'fa-user-ninja', desc: 'Sum of digits equals product of digits', match: n => isSpyNumber(n) },
            { id: 'pronic', name: 'Pronic Number', family: 'MATH_PROPERTIES', ep: 3100, icon: 'fa-square-plus', desc: 'Product of two consecutive integers n(n+1)', match: n => isPronic(n) },

            // FAMILY 39: PARITY_DIVISIBILITY (Even, Odd, Divisible by 3/7/11/13)
            { id: 'div_13', name: 'Lucky 13 Divisor', family: 'PARITY_DIVISIBILITY', ep: 300, icon: 'fa-percent', desc: 'Divisible by 13', match: n => n > 0 && n % 13 === 0 },
            { id: 'div_7', name: 'Seven Divisor', family: 'PARITY_DIVISIBILITY', ep: 150, icon: 'fa-divide', desc: 'Divisible by 7', match: n => n > 0 && n % 7 === 0 },
            { id: 'even', name: 'Even Parity', family: 'PARITY_DIVISIBILITY', ep: 10, icon: 'fa-arrows-split-up-and-left', desc: 'Even integer', match: n => n % 2 === 0 },
            { id: 'odd', name: 'Odd Parity', family: 'PARITY_DIVISIBILITY', ep: 10, icon: 'fa-code-branch', desc: 'Odd integer', match: n => n % 2 !== 0 }
        ];

        function countDigits(str) {
            const counts = {};
            for (let char of str) counts[char] = (counts[char] || 0) + 1;
            return counts;
        }

        /* ==========================================================================
           3. GLOBAL GAME STATE & LOCAL STORAGE MANAGEMENT
           ========================================================================== */
        let state = {
            rolls: [],
            unlockedBadges: new Set(),
            stats: {
                totalRolls: 0,
                maxEP: 0,
                tierCounts: { trash: 0, common: 0, uncommon: 0, rare: 0, epic: 0, anomaly: 0, mythic: 0 }
            },
            settings: {
                autoSaveMinTier: 'rare',
                soundEnabled: true,
                volume: 0.5
            }
        };

        let autoRollInterval = null;
        let autoSpeed = 1; // 1x, 2.5x, 10x, 'turbo'
        let currentTab = 'roll';
        let inventoryFavOnly = false;

        // Audio Synth Engine
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playSound(type) {
            if (!state.settings.soundEnabled) return;
            try {
                initAudio();
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const vol = state.settings.volume;

                if (type === 'roll') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(300, now);
                    osc.frequency.exponentialRampToValueAtTime(150, now + 0.05);
                    gain.gain.setValueAtTime(vol * 0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                } else if (type === 'badge') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.setValueAtTime(659.25, now + 0.08); // E5
                    gain.gain.setValueAtTime(vol * 0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                } else if (type === 'mythic') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(440, now);
                    osc.frequency.exponentialRampToValueAtTime(880, now + 0.4);
                    gain.gain.setValueAtTime(vol * 0.5, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.8);
                    osc.start(now);
                    osc.stop(now + 0.8);
                }
            } catch (e) {
                console.error("Audio synth error", e);
            }
        }

        function loadGameData() {
            try {
                const saved = localStorage.getItem('RNGdle_v3_Save');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    state.rolls = parsed.rolls || [];
                    state.unlockedBadges = new Set(parsed.unlockedBadges || []);
                    state.stats = parsed.stats || state.stats;
                    state.settings = { ...state.settings, ...(parsed.settings || {}) };
                }
            } catch (e) {
                console.error('Failed to load save data:', e);
            }
            updateUIHeaderStats();
        }

        function saveGameData() {
            try {
                const dataToSave = {
                    rolls: state.rolls,
                    unlockedBadges: Array.from(state.unlockedBadges),
                    stats: state.stats,
                    settings: state.settings
                };
                localStorage.setItem('RNGdle_v3_Save', JSON.stringify(dataToSave));
            } catch (e) {
                console.error('Failed to save data:', e);
            }
        }

        /* ==========================================================================
           4. SCORING & 39 FAMILY DEDUPLICATION ENGINE
           ========================================================================== */

        function evaluateRoll(num) {
            const formattedStr = String(num).padStart(6, '0');
            
            // 1. Calculate Base Digit Entropy
            let baseEP = 500;
            const uniqueDigits = new Set(formattedStr).size;
            baseEP += (6 - uniqueDigits) * 350;

            // 2. Find ALL matching badges
            const allMatchedBadges = BADGE_LIBRARY.filter(b => b.match(num, formattedStr));

            // 3. APPLY 39 FAMILY DEDUPLICATION RULE
            // Group matching badges by family and keep only the HIGHEST EP badge per family
            const familyMap = new Map();
            allMatchedBadges.forEach(badge => {
                if (!familyMap.has(badge.family) || familyMap.get(badge.family).ep < badge.ep) {
                    familyMap.set(badge.family, badge);
                }
            });

            const deduplicatedBadges = Array.from(familyMap.values());
            const deduplicatedBadgeEP = deduplicatedBadges.reduce((sum, b) => sum + b.ep, 0);
            const rawBadgeEP = allMatchedBadges.reduce((sum, b) => sum + b.ep, 0);

            // 4. Calculate Final Total EP
            const totalEP = baseEP + deduplicatedBadgeEP;

            // 5. Determine Tier based on authentic RNGdle thresholds
            let tier = TIERS.TRASH;
            if (totalEP >= TIERS.MYTHIC.minEP) tier = TIERS.MYTHIC;
            else if (totalEP >= TIERS.ANOMALY.minEP) tier = TIERS.ANOMALY;
            else if (totalEP >= TIERS.EPIC.minEP) tier = TIERS.EPIC;
            else if (totalEP >= TIERS.RARE.minEP) tier = TIERS.RARE;
            else if (totalEP >= TIERS.UNCOMMON.minEP) tier = TIERS.UNCOMMON;
            else if (totalEP >= TIERS.COMMON.minEP) tier = TIERS.COMMON;

            return {
                number: num,
                strNumber: formattedStr,
                totalEP: totalEP,
                baseEP: baseEP,
                rawBadgeEP: rawBadgeEP,
                deduplicatedBadgeEP: deduplicatedBadgeEP,
                allMatchedBadges: allMatchedBadges,
                deduplicatedBadges: deduplicatedBadges,
                tier: tier,
                timestamp: Date.now()
            };
        }

        /* ==========================================================================
           5. ROLLING INTERACTION & ANIMATION LOGIC
           ========================================================================== */

        function triggerManualRoll() {
            performRoll(true);
        }

        function performRoll(isManual = false) {
            const randomNumber = Math.floor(Math.random() * 1000001);
            const rollResult = evaluateRoll(randomNumber);

            playSound('roll');

            // Render Rolled Number to DOM
            const numEl = document.getElementById('rolled-number-text');
            numEl.textContent = randomNumber.toLocaleString('en-US').padStart(7, '0');
            
            // Render Tier & EP
            const tierBadge = document.getElementById('roll-tier-badge');
            tierBadge.className = `inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black tracking-wide uppercase bg-tier-${rollResult.tier.class} text-white shadow-lg`;
            tierBadge.innerHTML = `<i class="fa-solid fa-gem"></i> ${rollResult.tier.name}`;

            const epDisplay = document.getElementById('roll-ep-display');
            epDisplay.innerHTML = `${rollResult.totalEP.toLocaleString()} <span class="text-xs text-purple-400">EP</span>`;
            epDisplay.className = `text-xl md:text-2xl font-black text-tier-${rollResult.tier.class}`;

            // Card Glow Effect
            const glow = document.getElementById('card-glow');
            glow.style.background = rollResult.tier.color;

            // Percentile Beat Calculation
            const percentile = Math.min(99.999, Math.max(1, (rollResult.totalEP / 250000) * 100)).toFixed(2);
            document.getElementById('percentile-beat').innerHTML = `Beats approximately <strong class="text-purple-300">${percentile}%</strong> of standard random rolls!`;

            // Update Breakdown Inspector
            document.getElementById('ep-calc-base').textContent = `+${rollResult.baseEP.toLocaleString()} EP`;
            document.getElementById('ep-calc-raw').textContent = `+${rollResult.rawBadgeEP.toLocaleString()} EP`;
            document.getElementById('ep-calc-dedup-sum').textContent = `+${rollResult.deduplicatedBadgeEP.toLocaleString()} EP`;
            document.getElementById('ep-calc-families').textContent = `${rollResult.deduplicatedBadges.length} Active Families`;
            document.getElementById('ep-calc-final').textContent = `${rollResult.totalEP.toLocaleString()} EP`;

            // Update Matched Badges List (With Deduplication Highlights)
            renderActiveBadges(rollResult.allMatchedBadges, rollResult.deduplicatedBadges);

            // Handle New Badge Discovery Toasts
            rollResult.deduplicatedBadges.forEach(b => {
                if (!state.unlockedBadges.has(b.id)) {
                    state.unlockedBadges.add(b.id);
                    showToast(`🏆 NEW BADGE DISCOVERED: ${b.name} (+${b.ep.toLocaleString()} EP)`, 'amber');
                    playSound('badge');
                }
            });

            // Handle Mythic / High Roll Effects
            if (rollResult.tier === TIERS.MYTHIC || rollResult.tier === TIERS.ANOMALY) {
                confetti({ particleCount: 80, spread: 70, origin: { y: 0.6 } });
                playSound('mythic');
            }

            // Update Stats
            state.stats.totalRolls++;
            state.stats.tierCounts[rollResult.tier.class]++;
            if (rollResult.totalEP > state.stats.maxEP) {
                state.stats.maxEP = rollResult.totalEP;
                showToast(`🚀 NEW HIGH SCORE: ${rollResult.totalEP.toLocaleString()} EP!`, 'purple');
            }

            // Auto-Save Rule Evaluation
            const tierHierarchy = ['trash', 'common', 'uncommon', 'rare', 'epic', 'anomaly', 'mythic'];
            const minTierIdx = tierHierarchy.indexOf(state.settings.autoSaveMinTier);
            const currentTierIdx = tierHierarchy.indexOf(rollResult.tier.class);

            if (currentTierIdx >= minTierIdx || rollResult.deduplicatedBadges.length > 0) {
                state.rolls.unshift({
                    id: 'roll_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
                    num: randomNumber,
                    str: rollResult.strNumber,
                    ep: rollResult.totalEP,
                    tier: rollResult.tier.class,
                    badges: rollResult.deduplicatedBadges.map(b => b.name),
                    fav: false,
                    time: new Date().toLocaleTimeString()
                });
                if (state.rolls.length > 250) state.rolls.pop();
            }

            saveGameData();
            updateUIHeaderStats();
        }

        /* Render Active Badges on Roll Card with Deduplication Highlights */
        function renderActiveBadges(allMatched, deduplicated) {
            const container = document.getElementById('active-badges-list');
            const dedupSet = new Set(deduplicated.map(b => b.id));
            
            document.getElementById('active-badges-count').textContent = deduplicated.length;

            if (allMatched.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full flex flex-col items-center justify-center p-8 text-center text-slate-500 border border-dashed border-slate-800 rounded-xl">
                        <i class="fa-solid fa-ghost text-2xl mb-1 text-slate-600"></i>
                        <p class="text-xs font-medium">Standard Number - No badge family matched.</p>
                    </div>`;
                return;
            }

            container.innerHTML = allMatched.map(b => {
                const isActive = dedupSet.has(b.id);
                return `
                    <div class="glass-panel p-3 rounded-xl border ${isActive ? 'border-purple-500/40 bg-purple-950/20' : 'border-slate-800 opacity-40 bg-slate-900/40'} flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-8 h-8 rounded-lg ${isActive ? 'bg-purple-900/50 border border-purple-700 text-purple-300' : 'bg-slate-800 text-slate-500'} flex items-center justify-center text-sm">
                                <i class="fa-solid ${b.icon}"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="text-xs font-bold text-slate-200 truncate ${!isActive ? 'line-through text-slate-500' : ''}">${b.name}</div>
                                <div class="text-[10px] text-purple-400 font-mono">+${b.ep.toLocaleString()} EP (${b.family})</div>
                            </div>
                        </div>
                        <span class="text-[9px] font-extrabold uppercase px-2 py-0.5 rounded ${isActive ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-slate-800 text-slate-500'}">
                            ${isActive ? 'ACTIVE' : 'DEDEDUPED'}
                        </span>
                    </div>
                `;
            }).join('');
        }

        /* Auto Roll Speed Controls */
        function toggleAutoRoll() {
            if (autoRollInterval) {
                stopAutoRoll();
            } else {
                startAutoRoll();
            }
        }

        function startAutoRoll() {
            const btn = document.getElementById('auto-roll-btn');
            const icon = document.getElementById('auto-roll-icon');
            const label = document.getElementById('auto-roll-label');

            btn.classList.replace('bg-slate-800', 'bg-purple-600');
            icon.classList.add('fa-spin');
            label.textContent = 'Auto Roll: ON';

            const delay = autoSpeed === 'turbo' ? 20 : 1000 / autoSpeed;
            autoRollInterval = setInterval(() => {
                performRoll(false);
            }, delay);
        }

        function stopAutoRoll() {
            if (autoRollInterval) {
                clearInterval(autoRollInterval);
                autoRollInterval = null;
            }
            const btn = document.getElementById('auto-roll-btn');
            const icon = document.getElementById('auto-roll-icon');
            const label = document.getElementById('auto-roll-label');

            btn.classList.replace('bg-purple-600', 'bg-slate-800');
            icon.classList.remove('fa-spin');
            label.textContent = 'Auto Roll: OFF';
        }

        function setAutoSpeed(speed) {
            autoSpeed = speed;
            document.querySelectorAll('.speed-btn').forEach(b => {
                b.classList.remove('bg-purple-600', 'text-white');
                b.classList.add('text-slate-400');
            });

            const activeBtn = document.getElementById(`spd-${speed}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-purple-600', 'text-white');
                activeBtn.classList.remove('text-slate-400');
            }

            if (autoRollInterval) {
                stopAutoRoll();
                startAutoRoll();
            }
        }

        /* ==========================================================================
           6. INVENTORY & BADGES CODEX TAB RENDERING
           ========================================================================== */

        function renderInventory() {
            const grid = document.getElementById('inventory-grid');
            const searchTerm = document.getElementById('inv-search').value.toLowerCase();
            const selectedTier = document.getElementById('inv-tier-filter').value;
            const sortMode = document.getElementById('inv-sort').value;

            let filtered = state.rolls.filter(item => {
                const matchesSearch = String(item.num).includes(searchTerm) || 
                                     item.badges.some(b => b.toLowerCase().includes(searchTerm));
                const matchesTier = selectedTier === 'all' || item.tier === selectedTier;
                const matchesFav = !inventoryFavOnly || item.fav;
                return matchesSearch && matchesTier && matchesFav;
            });

            filtered.sort((a, b) => {
                if (sortMode === 'ep-desc') return b.ep - a.ep;
                if (sortMode === 'ep-asc') return a.ep - b.ep;
                if (sortMode === 'newest') return b.timestamp - a.timestamp;
                if (sortMode === 'oldest') return a.timestamp - b.timestamp;
                return 0;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-500">
                        <i class="fa-solid fa-box-open text-4xl mb-3 text-slate-600"></i>
                        <p class="text-sm font-medium">No saved rolls found matching filters.</p>
                    </div>`;
                return;
            }

            grid.innerHTML = filtered.map(item => `
                <div class="glass-panel p-4 rounded-2xl border border-tier-${item.tier} relative group transition">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[10px] uppercase font-black px-2 py-0.5 rounded-md bg-tier-${item.tier} text-white">
                            ${item.tier}
                        </span>
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] text-slate-500">${item.time}</span>
                            <button onclick="toggleFavRoll('${item.id}')" class="text-sm ${item.fav ? 'text-amber-400' : 'text-slate-600 hover:text-amber-400'}">
                                <i class="fa-solid fa-star"></i>
                            </button>
                        </div>
                    </div>

                    <div class="text-2xl font-black font-mono text-slate-100 my-1">
                        ${item.num.toLocaleString('en-US').padStart(6, '0')}
                    </div>

                    <div class="text-xs font-bold text-purple-400 mb-2">
                        ${item.ep.toLocaleString()} EP
                    </div>

                    <div class="flex flex-wrap gap-1 text-[10px] text-slate-300">
                        ${item.badges.map(b => `<span class="bg-slate-900 border border-slate-800 px-1.5 py-0.5 rounded">${b}</span>`).join('') || '<span class="text-slate-600">No Badges</span>'}
                    </div>
                </div>
            `).join('');
        }

        function toggleFavRoll(id) {
            const roll = state.rolls.find(r => r.id === id);
            if (roll) {
                roll.fav = !roll.fav;
                saveGameData();
                renderInventory();
            }
        }

        function toggleInventoryFavFilter() {
            inventoryFavOnly = !inventoryFavOnly;
            const btn = document.getElementById('inv-fav-toggle');
            if (inventoryFavOnly) {
                btn.classList.add('bg-amber-500/20', 'border-amber-500/50', 'text-amber-300');
            } else {
                btn.classList.remove('bg-amber-500/20', 'border-amber-500/50', 'text-amber-300');
            }
            renderInventory();
        }

        function confirmClearInventory() {
            if (confirm('Are you sure you want to clear saved inventory rolls? Unlocked badges will be preserved.')) {
                state.rolls = [];
                saveGameData();
                renderInventory();
                updateUIHeaderStats();
            }
        }

        /* Render Official 39 Families Badge Dex Gallery */
        function renderBadgeDex() {
            const grid = document.getElementById('badges-dex-grid');
            const familyFilter = document.getElementById('badge-family-filter').value;
            const statusFilter = document.getElementById('badge-status-filter').value;

            // Populate Families Filter Option Dropdown
            const families = Array.from(new Set(BADGE_LIBRARY.map(b => b.family)));
            const filterSelect = document.getElementById('badge-family-filter');
            if (filterSelect.options.length <= 1) {
                families.forEach(f => {
                    const opt = document.createElement('option');
                    opt.value = f;
                    opt.textContent = `${f} Family`;
                    filterSelect.appendChild(opt);
                });
            }

            const filteredBadges = BADGE_LIBRARY.filter(b => {
                const matchesFamily = familyFilter === 'all' || b.family === familyFilter;
                const isUnlocked = state.unlockedBadges.has(b.id);
                const matchesStatus = statusFilter === 'all' || 
                                     (statusFilter === 'discovered' && isUnlocked) || 
                                     (statusFilter === 'locked' && !isUnlocked);
                return matchesFamily && matchesStatus;
            });

            if (filteredBadges.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-500">
                        <i class="fa-solid fa-award text-4xl mb-3 text-slate-600"></i>
                        <p class="text-sm font-medium">No badges match the selected filter criteria.</p>
                    </div>`;
                return;
            }

            grid.innerHTML = filteredBadges.map(b => {
                const unlocked = state.unlockedBadges.has(b.id);
                return `
                    <div class="glass-panel p-4 rounded-2xl border ${unlocked ? 'border-amber-500/40 bg-amber-950/10' : 'border-slate-800 opacity-60'} badge-card flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <div class="w-10 h-10 rounded-xl ${unlocked ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30' : 'bg-slate-900 text-slate-600 border border-slate-800'} flex items-center justify-center text-lg">
                                    <i class="fa-solid ${b.icon}"></i>
                                </div>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${unlocked ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-slate-900 text-slate-500'}">
                                    ${unlocked ? 'DISCOVERED' : 'LOCKED'}
                                </span>
                            </div>
                            <h4 class="text-xs font-bold text-slate-100">${b.name}</h4>
                            <div class="text-[10px] font-mono text-purple-400 font-bold mb-1">+${b.ep.toLocaleString()} EP (${b.family})</div>
                            <p class="text-[11px] text-slate-400 leading-tight">${b.desc}</p>
                        </div>
                    </div>
                `;
            }).join('');
        }

        /* Render Statistics View */
        function renderStats() {
            document.getElementById('st-total-rolls').textContent = state.stats.totalRolls.toLocaleString();
            document.getElementById('st-max-ep').textContent = `${state.stats.maxEP.toLocaleString()} EP`;
            document.getElementById('st-badges-unlocked').textContent = `${state.unlockedBadges.size} / ${BADGE_LIBRARY.length}`;
            document.getElementById('st-mythics-count').textContent = state.stats.tierCounts.mythic || 0;

            const barsContainer = document.getElementById('tier-distribution-bars');
            const total = state.stats.totalRolls || 1;

            barsContainer.innerHTML = Object.keys(TIERS).map(key => {
                const tier = TIERS[key];
                const count = state.stats.tierCounts[tier.class] || 0;
                const pct = ((count / total) * 100).toFixed(1);
                return `
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-medium">
                            <span class="text-tier-${tier.class} font-bold">${tier.name}</span>
                            <span class="text-slate-400">${count.toLocaleString()} (${pct}%)</span>
                        </div>
                        <div class="w-full bg-slate-900 h-2 rounded-full overflow-hidden border border-slate-800">
                            <div class="bg-tier-${tier.class} h-full transition-all duration-300" style="width: ${pct}%"></div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        /* Navigation & Settings Management */
        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.tab-view').forEach(v => v.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('bg-purple-600', 'text-white', 'shadow');
                b.classList.add('text-slate-400');
            });

            document.getElementById(`view-${tab}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-btn-${tab}`);
            activeBtn.classList.add('bg-purple-600', 'text-white', 'shadow');
            activeBtn.classList.remove('text-slate-400');

            if (tab === 'inventory') renderInventory();
            if (tab === 'badges') renderBadgeDex();
            if (tab === 'stats') renderStats();
        }

        function updateUIHeaderStats() {
            document.getElementById('nav-inventory-count').textContent = state.rolls.length;
            document.getElementById('nav-badge-progress').textContent = `${state.unlockedBadges.size}/${BADGE_LIBRARY.length}`;
            document.getElementById('stat-total-rolls').textContent = state.stats.totalRolls.toLocaleString();
            document.getElementById('stat-best-ep').textContent = `${state.stats.maxEP.toLocaleString()} EP`;
        }

        function updateAutoSaveTier(val) {
            state.settings.autoSaveMinTier = val;
            saveGameData();
        }

        function toggleAudio() {
            state.settings.soundEnabled = !state.settings.soundEnabled;
            document.getElementById('audio-icon').className = state.settings.soundEnabled ? 'fa-solid fa-volume-high' : 'fa-solid fa-volume-xmark text-red-400';
            saveGameData();
        }

        function setVolume(val) {
            state.settings.volume = parseFloat(val);
            saveGameData();
        }

        function openSettingsModal() {
            document.getElementById('settings-modal').classList.remove('hidden');
            document.getElementById('settings-modal').classList.add('flex');
        }

        function closeSettingsModal() {
            document.getElementById('settings-modal').classList.add('hidden');
            document.getElementById('settings-modal').classList.remove('flex');
        }

        function showToast(message, color = 'purple') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `glass-panel px-4 py-3 rounded-2xl border border-${color}-500/50 text-xs font-bold text-slate-100 shadow-xl flex items-center gap-2 animate-bounce-short pointer-events-auto`;
            toast.innerHTML = `<i class="fa-solid fa-bell text-${color}-400"></i> ${message}`;

            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3500);
        }

        /* JSON Data Export / Import */
        function exportDataJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `RNGdle_Save_${Date.now()}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function triggerImportJSON() {
            document.getElementById('import-file-input').click();
        }

        function importDataJSON(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed && parsed.stats) {
                        state = parsed;
                        state.unlockedBadges = new Set(parsed.unlockedBadges || []);
                        saveGameData();
                        location.reload();
                    }
                } catch (err) {
                    alert('Invalid JSON Save file structure.');
                }
            };
            reader.readAsText(file);
        }

        function resetAllGameData() {
            if (confirm('CRITICAL: Reset all progress, inventory, and badge achievements?')) {
                localStorage.removeItem('RNGdle_v3_Save');
                location.reload();
            }
        }

        // Initialize on Window Load
        window.onload = function() {
            loadGameData();
            renderBadgeDex();
            performRoll(false);
        };
    </script>
</body>
</html>

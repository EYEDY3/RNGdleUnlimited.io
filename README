    <script>
        /* ==========================================================================
           1. RNGdle TIER DEFINITIONS & HELPER MATH FUNCTIONS
           ========================================================================== */
        
        const TIERS = {
            TRASH:    { name: 'Trash',    minEP: 0,        class: 'trash',    color: '#64748b' },
            COMMON:   { name: 'Common',   minEP: 2087,     class: 'common',   color: '#a855f7' },
            UNCOMMON: { name: 'Uncommon', minEP: 5802,     class: 'uncommon', color: '#3b82f6' },
            RARE:     { name: 'Rare',     minEP: 10074,    class: 'rare',     color: '#06b6d4' },
            EPIC:     { name: 'Epic',     minEP: 22293,    class: 'epic',     color: '#10b981' },
            ANOMALY:  { name: 'Anomaly',  minEP: 35469,    class: 'anomaly',  color: '#f59e0b' },
            MYTHIC:   { name: 'Mythic',   minEP: 162292,   class: 'mythic',   color: '#ef4444' }
        };

        function isPrime(num) {
            if (num <= 1) return false;
            if (num <= 3) return true;
            if (num % 2 === 0 || num % 3 === 0) return false;
            for (let i = 5; i * i <= num; i += 6) {
                if (num % i === 0 || num % (i + 2) === 0) return false;
            }
            return true;
        }

        function isPerfectPower(n, maxExp = 19) {
            if (n <= 1) return false;
            for (let b = 2; b * b <= n; b++) {
                let p = b * b;
                let exp = 2;
                while (p <= n && exp <= maxExp) {
                    if (p === n) return true;
                    p *= b;
                    exp++;
                }
            }
            return false;
        }

        function isFibonacci(n) {
            if (n < 0) return false;
            const isSq = x => Math.sqrt(x) % 1 === 0;
            return isSq(5 * n * n + 4) || isSq(5 * n * n - 4);
        }

        function digitSum(n) {
            return String(n).split('').reduce((acc, curr) => acc + parseInt(curr, 10), 0);
        }

        function isHarshad(n) {
            if (n <= 0) return false;
            const sum = digitSum(n);
            return n % sum === 0;
        }

        function isSpyNumber(n) {
            const digits = String(n).split('').map(Number);
            const sum = digits.reduce((a, b) => a + b, 0);
            const prod = digits.reduce((a, b) => a * b, 1);
            return sum === prod;
        }

        function isPronic(n) {
            if (n < 0) return false;
            const r = Math.floor(Math.sqrt(n));
            return r * (r + 1) === n;
        }

        function isStrobogrammatic(s) {
            const map = { '0':'0', '1':'1', '6':'9', '8':'8', '9':'6' };
            let l = 0, r = s.length - 1;
            while (l <= r) {
                if (!map[s[l]] || map[s[l]] !== s[r]) return false;
                l++; r--;
            }
            return true;
        }

